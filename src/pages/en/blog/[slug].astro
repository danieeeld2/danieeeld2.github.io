---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import AudioAnalyzer from '../../../components/AudioAnalyzer.jsx';
import FFTPlayground from '../../../components/FFTPlayground.jsx';
import ConsistentHashPlayground from '../../../components/ConsistentHashPlayground.jsx';
import JumpHashStepper from '../../../components/JumpHashStepper.jsx';
import BloomFilterPlayground from '../../../components/BloomFilterPlayground.jsx';
import BloomOptimizer from '../../../components/BloomOptimizer.jsx';
import LSMVisualizer from '../../../components/LSMVisualizer.jsx';
import LSMBenchmark from '../../../components/LSMBenchmark.jsx';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

import data from '../../../data/en.json';

export function getStaticPaths() {
  const blogDir = path.join(process.cwd(), 'src', 'content', 'blog', 'en');
  if (!fs.existsSync(blogDir)) return [];
  const files = fs.readdirSync(blogDir).filter(f => f.endsWith('.md'));
  return files.map(file => ({
    params: { slug: file.replace('.md', '') },
  }));
}

const { slug } = Astro.params;
const filePath = path.join(process.cwd(), 'src', 'content', 'blog', 'en', `${slug}.md`);
const content = fs.readFileSync(filePath, 'utf-8');

const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
const frontmatter = frontmatterMatch?.[1] || '';
const title = frontmatter.match(/title:\s*"(.+)"/)?.[1] || '';
const date = frontmatter.match(/date:\s*"(.+)"/)?.[1] || '';

const markdownBody = content.replace(/^---\n[\s\S]*?\n---\n/, '');

// Split at component markers
const MARKERS = [
  '<AudioAnalyzer client:load />',
  '<FFTPlayground client:load />',
  '<ConsistentHashPlayground client:load />',
  '<JumpHashStepper client:load />',
  '<BloomFilterPlayground client:load />',
  '<BloomOptimizer client:load />',
  '<LSMVisualizer client:load />',
  '<LSMBenchmark client:load />',
];

let segments = [markdownBody];
for (const marker of MARKERS) {
  const newSegments = [];
  for (const seg of segments) {
    if (typeof seg === 'string' && seg.includes(marker)) {
      const parts = seg.split(marker);
      parts.forEach((part, i) => {
        newSegments.push(part);
        if (i < parts.length - 1) newSegments.push({ component: marker });
      });
    } else {
      newSegments.push(seg);
    }
  }
  segments = newSegments;
}

// Protect $$...$$ and $...$ fragments from Markdown's parser (marked).
// Replace them with opaque placeholders before marked runs, then restore
// them in the resulting HTML. This way marked never touches underscores
// or other LaTeX syntax inside math, and KaTeX (auto-render from the CDN
// in Layout.astro) renders the formulas in the browser afterwards.
function renderMarkdownWithMath(md) {
  const mathFragments = [];
  let counter = 0;

  // Display math: $$...$$ (can be multiline)
  let protectedMd = md.replace(/\$\$([\s\S]+?)\$\$/g, (_, expr) => {
    const placeholder = `@@MATHBLOCK${counter}@@`;
    mathFragments.push({ placeholder, replacement: `$$${expr}$$` });
    counter++;
    return placeholder;
  });

  // Inline math: $...$ (no line breaks, no $ inside)
  protectedMd = protectedMd.replace(/\$([^\$\n]+?)\$/g, (_, expr) => {
    const placeholder = `@@MATHINLINE${counter}@@`;
    mathFragments.push({ placeholder, replacement: `$${expr}$` });
    counter++;
    return placeholder;
  });

  let html = marked(protectedMd);

  for (const { placeholder, replacement } of mathFragments) {
    html = html.replace(placeholder, replacement);
  }
  return html;
}

const rendered = await Promise.all(
  segments.map(seg => typeof seg === 'string' ? renderMarkdownWithMath(seg) : Promise.resolve(seg))
);

const lang = 'en';
---

<Layout title={`${title} — Daniel Alconchel`} description={title} lang={lang}>
  <Nav nav={data.nav} lang={lang} />
  <main class="pt-28 pb-20">
    <article class="max-w-3xl mx-auto px-6">
      <a href={`/${lang}/#blog`} class="inline-flex items-center gap-2 text-sm font-mono text-sand-500 hover:text-sand-700 dark:hover:text-sand-300 mb-8 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
        Back
      </a>
      <header class="mb-10">
        <p class="font-mono text-sm text-sand-500 mb-3">{date}</p>
        <h1 class="font-display text-4xl md:text-5xl italic tracking-tight">{title}</h1>
      </header>
      <div class="prose-blog">
        {rendered.map((seg, i) => {
          if (typeof seg === 'string') return <Fragment key={i} set:html={seg} />;
          if (seg.component === '<AudioAnalyzer client:load />') return <AudioAnalyzer key={i} client:load />;
          if (seg.component === '<FFTPlayground client:load />') return <FFTPlayground key={i} client:load />;
          if (seg.component === '<ConsistentHashPlayground client:load />') return <ConsistentHashPlayground key={i} client:load />;
          if (seg.component === '<JumpHashStepper client:load />') return <JumpHashStepper key={i} client:load />;
          if (seg.component === '<BloomFilterPlayground client:load />') return <BloomFilterPlayground key={i} client:load />;
          if (seg.component === '<BloomOptimizer client:load />') return <BloomOptimizer key={i} client:load />;
          if (seg.component === '<LSMVisualizer client:load />') return <LSMVisualizer key={i} client:load />;
          if (seg.component === '<LSMBenchmark client:load />') return <LSMBenchmark key={i} client:load />;
          return null;
        })}
      </div>
    </article>
  </main>
  <Footer footer={data.footer} contact={data.contact} />
</Layout>
